# Copie para .env e ajuste. Nunca versione o .env real.

# Banco de dados (PostgreSQL 16+)
DATABASE_URL=postgresql://rpg:rpg@localhost:5432/rpg_dev
# TLS: disable (local) | require (cifrado, sem validar) | verify-full (cifrado e validado; exige DATABASE_CA_CERT)
DATABASE_SSL=disable
# Certificado PEM da autoridade do banco (ex.: o "SSL certificate" do Supabase). Quebras de linha podem ser \n.
DATABASE_CA_CERT=
# Conexões simultâneas no pool (no Supabase, respeite o limite do pooler do seu plano).
DATABASE_POOL_MAX=10

# Origem pública da interface (CSRF/CORS e redirecionamentos OAuth).
# Desenvolvimento: http://localhost:5173 · Produção: https://seu-dominio
APP_ORIGIN=http://localhost:5173
PORT=3333

# O primeiro usuário real sempre pode se cadastrar e vira administrador.
# Depois disso, novos cadastros só com ALLOW_REGISTRATION=true.
ALLOW_REGISTRATION=false
SESSION_TTL_DAYS=30

# Avaliador diário (penalidades, expiração, recorrências). 0 desativa o agendador.
EVALUATION_INTERVAL_MINUTES=15
LOG_LEVEL=info

# 32 bytes em base64 para cifrar tokens de integração. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# Strava (opcional) — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Segredo usado no handshake e no caminho da URL do webhook.
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_API_BASE=https://www.strava.com/api/v3

# Lyfta (a chave de API é cadastrada por usuário na interface)
LYFTA_API_BASE=https://my.lyfta.app

# Produção sem Docker: diretório do build da interface servido pela API.
# WEB_DIST_DIR=../web/dist

# Confirmação de e-mail no cadastro. Com SMTP_USER e SMTP_PASSWORD preenchidos, novas contas precisam
# confirmar o e-mail (EMAIL_VERIFICATION=auto). Padrão: Gmail com senha de app (smtp.gmail.com:465).
# EMAIL_VERIFICATION=auto
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Ascend <seu-email@gmail.com>"
